# =======================================================
# PTW System Environment Variables & n8n Webhook Config
# =======================================================

# آدرس وب‌هوک n8n برای ارسال رویدادهای تغییر وضعیت پرمیت (PermitStatusChanged)
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/ptw-permit-status-changed

# کلید امنیتی جهت احراز هویت درخواست‌های API از سمت n8n
N8N_API_KEY=ptw_n8n_secret_token_2026

# آدرس دامنه سامانه جهت تولید کلیدها و لینک‌های توکن‌دار تایید ۱-کلیکی (Signed URL)
APP_URL=http://localhost:3000
